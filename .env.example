# Copy to .env and adjust. Every setting in app/config.py can be set as KP_<NAME>.

# Auth: comma-separated "api_key:user_id" pairs. Leave empty to disable auth (local dev only).
KP_API_KEYS=

# Storage (defaults to SQLite + Chroma under ./data)
# KP_DATA_DIR=data
# KP_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/knowledge

# Models
# KP_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# KP_RERANKER_ENABLED=true
# KP_OCR_ENABLED=true

# AI Gateway (Claude). The Anthropic SDK reads ANTHROPIC_API_KEY from the environment.
# ANTHROPIC_API_KEY=sk-ant-...
# KP_LLM_PROVIDER=anthropic        # or "disabled"
# KP_LLM_MODEL=claude-opus-5
# KP_LLM_RATE_LIMIT_PER_MINUTE=20

# Logging
# KP_LOG_JSON=true
